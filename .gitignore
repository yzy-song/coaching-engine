# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the example, which documents the only two variables this app reads
# and stops Vercel offering the backend's secrets instead.
!.env.example
# ...and the production build config, which points the demo at the live API
# (both values are public URLs/flags, never secrets).
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
# Claude Code local tooling (machine-specific — not shared)
.claude/
.mcp.json
.code-review-graph/
