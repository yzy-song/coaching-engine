# The frontend's ENTIRE configuration. Two variables, both public by design.
#
# This file exists because Vercel scans for a .env.example and offers to
# create whatever it finds. Pointed at the repo root it finds the BACKEND's
# example and offers DATABASE_URL, OPENAI_API_KEY and a service account path,
# none of which this app reads. Worse than useless: live credentials sitting
# in a system with no use for them is an extra place to leak from.
#
# The browser talks to the API over HTTP and nothing else. No database
# connection, no model key, no cloud credentials ever reach this bundle.

# NEXT_PUBLIC_ variables are inlined at BUILD time, not read at runtime.
# Changing either one in a dashboard does nothing until you redeploy.

# false serves the in-memory mock, which is how the frontend is developed
# without a backend running.
NEXT_PUBLIC_USE_REAL_API=true

# Local:      http://127.0.0.1:8000/api/v1
# Deployed:   https://coaching-engine-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://coaching-engine-api.onrender.com/api/v1
